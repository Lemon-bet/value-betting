# Copiar a .env y rellenar. No subir .env a ningún sitio.
ODDSPAPI_KEY=
VB_MONTHLY_QUOTA=5000
VB_QUOTA_RESERVE=300

# Casas (slugs de OddsPapi). La referencia debe estar en la suscripción.
VB_REF_BOOKMAKER=pinnacle+30
VB_EXCHANGE=betfair-ex
VB_EXCHANGE_COMMISSION=0.05
VB_SOFT_BOOKMAKERS=bet365.es,paf.es,leovegas.es,pokerstars.es

# Competiciones (ids de OddsPapi, fútbol, verificados 25-oct-2026):
#   7 Champions · 679 Europa League · 34480 Conference · 8 LaLiga · 17 Premier · 23 Serie A · 34 Ligue 1 · 35 Bundesliga
# Arranque recomendado (≈2.500 consultas/mes): LaLiga + Champions + Europa League
VB_TOURNAMENTS=8,7,679

# Ventana de muestreo (minutos antes/después del inicio) e intervalo entre barridos
VB_WINDOW_BEFORE_MIN=100
VB_WINDOW_AFTER_MIN=3
VB_SWEEP_INTERVAL_MIN=10
VB_SWEEP_INTERVAL_MAX_MIN=30

# Avisos (opcional). Crear bot con @BotFather; chat_id con @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VB_HEARTBEAT_H=6

VB_DB=data/vb.sqlite
VB_LOG=data/vb.log
